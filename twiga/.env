# Twiga uses one local Ollama model for greetings, titles, and chat.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:31b
OLLAMA_NUM_CTX=8192

# Local development defaults. For hosting, set these in the host's
# environment/secrets settings instead — do not upload this .env file.
# HOST defaults to 0.0.0.0 in code, which works for both local dev and
# hosting; only set it here if you specifically need to restrict it.
PORT=3000
# ALLOWED_ORIGINS=https://twiga.example.com
RATE_LIMIT_PER_MINUTE=20
