# Twiga uses one Ollama model for greeting, titles, and chat.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:31b
OLLAMA_NUM_CTX=8192

# Local development defaults. For hosting, configure these in the server environment.
# HOST=0.0.0.0 (the code's default already) — override only if you need to restrict it.
PORT=3000
# ALLOWED_ORIGINS=https://twiga.example.com
RATE_LIMIT_PER_MINUTE=20
